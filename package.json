{
  "name": "finops-angular-microfrontends",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "pnpm run start:all",
    "start:all": "concurrently -k -n SHELL,OPERACIONES,REPORTES,ADMIN -c blue,green,magenta,yellow \"pnpm run start:shell\" \"pnpm run start:operaciones\" \"pnpm run start:reportes\" \"pnpm run start:administracion\"",
    "start:shell": "ng serve shell --port 4200",
    "start:operaciones": "ng serve mf-operaciones --port 4201",
    "start:reportes": "ng serve mf-reportes --port 4202",
    "start:administracion": "ng serve mf-administracion --port 4203",
    "build": "pnpm run build:all",
    "build:all": "ng build shell && ng build mf-operaciones && ng build mf-reportes && ng build mf-administracion",
    "build:shell": "ng build shell",
    "build:operaciones": "ng build mf-operaciones",
    "build:reportes": "ng build mf-reportes",
    "build:administracion": "ng build mf-administracion",
    "verify:architecture": "node scripts/verify-architecture.mjs"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-architects/module-federation": "^21.2.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "concurrently": "^9.2.0",
    "ngx-build-plus": "20.0.0",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.15.1"
}
